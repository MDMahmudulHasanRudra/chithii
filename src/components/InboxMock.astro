---
// An illustration of the Chithii inbox, drawn in HTML so it stays sharp and needs no images.
const threads = [
  { name: 'Nusrat Jahan', ch: 'WhatsApp', color: 'bg-wa', last: '3 ta nile discount pabo? half advance dile hobe?', time: '2m', active: true, badge: 'AI handed over' },
  { name: 'Tanvir Ahmed', ch: 'Messenger', color: 'bg-fb', last: 'Chattogram e delivery charge koto?', time: '4m', badge: 'AI answered' },
  { name: 'nadia.styles', ch: 'Instagram', color: 'bg-ig', last: 'Is the maroon saree back in stock?', time: '9m', badge: 'AI answered' },
  { name: 'Rafiq Hossain', ch: 'Telegram', color: 'bg-tg', last: 'Parcel peye gechi, thanks 🙏', time: '18m', badge: 'Resolved' },
  { name: 'Website visitor', ch: 'Website chat', color: 'bg-accent', last: 'Can I pay with bKash?', time: '21m' },
];
---

<div class="overflow-hidden rounded-2xl border border-tide-line bg-white text-left text-ink shadow-[var(--shadow-float)]" role="img" aria-label="Illustration of the Chithii inbox: conversations from WhatsApp, Messenger, Instagram, Telegram and website chat in one list, with an AI reply, a handover to a teammate, a bKash payment and a courier booking in the open conversation.">
  <!-- window bar -->
  <div class="flex items-center gap-2 border-b border-line bg-mist px-4 py-2.5">
    <span class="size-2.5 rounded-full bg-line-strong"></span><span class="size-2.5 rounded-full bg-line-strong"></span><span class="size-2.5 rounded-full bg-line-strong"></span>
    <span class="ml-3 text-xs font-medium text-subtle">app.chithii.com / All conversations</span>
  </div>
  <div class="grid md:grid-cols-[17rem_1fr]">
    <!-- list -->
    <ul class="hidden border-r border-line md:block">
      {
        threads.map((t) => (
          <li class:list={['border-b border-line px-4 py-3', t.active && 'bg-accent-soft']}>
            <div class="flex items-center gap-2">
              <span class:list={['size-2 shrink-0 rounded-full', t.color]} />
              <span class="truncate text-[0.82rem] font-semibold">{t.name}</span>
              <span class="ml-auto text-[0.7rem] text-subtle">{t.time}</span>
            </div>
            <p class="mt-1 truncate pl-4 text-[0.78rem] text-muted">{t.last}</p>
            <div class="mt-1.5 flex gap-1.5 pl-4">
              <span class="rounded bg-sunken px-1.5 py-0.5 text-[0.65rem] font-medium text-muted">{t.ch}</span>
              {t.badge && <span class="rounded bg-marigold-soft px-1.5 py-0.5 text-[0.65rem] font-medium text-marigold-ink">{t.badge}</span>}
            </div>
          </li>
        ))
      }
    </ul>
    <!-- thread -->
    <div class="flex flex-col">
      <div class="flex items-center gap-3 border-b border-line px-5 py-3">
        <span class="flex size-8 items-center justify-center rounded-full bg-wa/15 text-xs font-bold text-ok-ink">NJ</span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold">Nusrat Jahan</p>
          <p class="text-[0.72rem] text-subtle">WhatsApp · returning customer · assigned to Rudra</p>
        </div>
        <span class="ml-auto rounded-full border border-marigold-line bg-marigold-soft px-2.5 py-1 text-[0.7rem] font-semibold text-marigold-ink">Open · Sales</span>
      </div>
      <div class="flex-1 space-y-3 bg-mist/60 px-5 py-5 text-[0.85rem]">
        <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white px-3.5 py-2.5 shadow-[var(--shadow-card)]">
          <p class="text-[0.7rem] font-semibold text-muted">Nusrat · 10:02</p>
          <p class="mt-0.5">Blue kurti ta M size e ache? Dhaka te koto din lagbe?</p>
        </div>
        <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm border border-accent-line bg-accent-soft px-3.5 py-2.5">
          <p class="text-[0.7rem] font-semibold text-accent-ink">AI reply · 10:02 · 96% confident</p>
          <p class="mt-0.5 font-bangla">জি আপু, নীল কুর্তি M সাইজে স্টকে আছে, দাম ৳১,৪৫০। ঢাকার ভেতরে ১–২ দিনে ডেলিভারি, চার্জ ৳৬০।</p>
          <p class="mt-1 text-[0.68rem] text-accent-ink/80">From your product catalogue and delivery policy</p>
        </div>
        <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white px-3.5 py-2.5 shadow-[var(--shadow-card)]">
          <p class="text-[0.7rem] font-semibold text-muted">Nusrat · 10:04</p>
          <p class="mt-0.5">3 ta nile discount pabo? half advance dile hobe?</p>
        </div>
        <div class="flex items-center gap-2 text-[0.72rem] font-medium text-marigold-ink">
          <span class="h-px flex-1 bg-marigold-line"></span>
          Discount asked · AI 58% sure · handed to Rudra
          <span class="h-px flex-1 bg-marigold-line"></span>
        </div>
        <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-tide px-3.5 py-2.5 text-white">
          <p class="text-[0.7rem] font-semibold text-tide-muted">Rudra · sales team · 10:05</p>
          <p class="mt-0.5">3 ta nile 10% off, apu! ৳500 advance bKash e din, baki ta cash on delivery.</p>
          <div class="mt-2 flex flex-wrap gap-1.5 text-[0.68rem] font-semibold">
            <span class="rounded bg-white/15 px-1.5 py-0.5">bKash link · ৳500</span>
            <span class="rounded bg-white/15 px-1.5 py-0.5">Order #1042 · ৳3,975</span>
          </div>
        </div>
        <div class="flex items-center justify-center gap-2 text-[0.72rem] font-medium text-ok-ink">
          <span class="size-1.5 rounded-full bg-ok"></span>
          10:07 · ৳500 paid via bKash · Steadfast pickup booked
        </div>
      </div>
      <div class="flex items-center gap-2 border-t border-line px-4 py-3">
        <span class="flex-1 rounded-lg border border-line px-3 py-2 text-[0.8rem] text-subtle">Reply, or type / for Copilot…</span>
        <span class="rounded-lg bg-tide px-3 py-2 text-[0.75rem] font-semibold text-white">Send</span>
      </div>
    </div>
  </div>
</div>

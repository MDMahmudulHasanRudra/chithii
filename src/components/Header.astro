---
import Logo from './Logo.astro';
import { nav, site } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="no-print sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-site flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="-ml-1 rounded-md p-1 no-underline" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="rounded-md px-3 py-2 font-medium text-ink no-underline hover:text-accent aria-[current=page]:text-accent"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.appUrl} class="ml-2 rounded-md px-3 py-2 font-medium text-ink no-underline hover:text-accent">Sign in</a>
      <a href="/contact" class="btn btn-primary ml-1 min-h-10 py-2">Book a demo</a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-line px-3 py-2 font-medium [&::-webkit-details-marker]:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="group-open:hidden"></path>
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden group-open:block"></path>
        </svg>
        Menu
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 mt-2 flex w-64 flex-col gap-1 rounded-xl border border-line bg-white p-2 shadow-[var(--shadow-float)]"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="rounded-md px-3 py-2.5 font-medium text-ink no-underline hover:bg-mist aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          ))
        }
        <a href={site.appUrl} class="rounded-md px-3 py-2.5 font-medium text-ink no-underline hover:bg-mist">Sign in</a>
        <a href="/contact" class="btn btn-primary mt-1">Book a demo</a>
      </nav>
    </details>
  </div>
</header>

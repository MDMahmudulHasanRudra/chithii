---
// The Chithii mark, taken from the Chithii app, with the wordmark beside it.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const tile = tone === 'dark' ? 'bg-tide text-white' : 'bg-white text-tide';
const word = tone === 'dark' ? 'text-ink' : 'text-white';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span class:list={['flex size-9 items-center justify-center rounded-[10px]', tile]}>
    <svg viewBox="0 0 24 24" fill="none" class="size-[62%]" aria-hidden="true">
      <path d="M5.5 16.5V8.2A2.7 2.7 0 0 1 8.2 5.5h4.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
      <path d="M18.5 7.5v8.3a2.7 2.7 0 0 1-2.7 2.7h-4.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
      <circle cx="17" cy="5.6" r="2.3" fill="currentColor"></circle>
      <circle cx="7" cy="18.4" r="2.3" fill="currentColor"></circle>
    </svg>
  </span>
  <span class:list={['text-[1.3rem] font-semibold tracking-[-0.02em]', word]}>Chithii</span>
</span>

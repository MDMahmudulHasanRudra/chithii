---
// The Chithii logo: the ribbon "C", the "hithii" wordmark and the swoosh, from the master in
// logo/ (generated into public/brand/ by `npm run brand`). `light` has a white wordmark, for dark
// backgrounds such as the footer.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = 'h-10' } = Astro.props;
const file = tone === 'dark' ? 'chithii-logo' : 'chithii-logo-light';
---

<picture>
  <source srcset={`/brand/${file}.webp`} type="image/webp" />
  <img src={`/brand/${file}.png`} width="243" height="96" alt="Chithii" class:list={['block w-auto', className]} decoding="async" />
</picture>

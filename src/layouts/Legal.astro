---
// Layout for policy and trust pages: title, dates, "On this page" index, prose.
import Base from './Base.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  intro?: string;
  toc?: { id: string; label: string }[];
  dated?: boolean;
  eyebrow?: string;
  badge?: string;
}
const { title, description, intro, toc = [], dated = true, eyebrow = `${site.name} · Trust and legal`, badge } = Astro.props;
---

<Base title={title} description={description}>
  <div class="border-b border-line bg-mist">
    <div class="container-site py-12 sm:py-16">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-4xl font-semibold sm:text-5xl">
        {title}
        {badge && <span class="rounded-full border border-ok/30 bg-ok-soft px-3 py-1 text-sm font-semibold tracking-normal text-ok-ink">{badge}</span>}
      </h1>
      {intro && <p class="lead mt-4 max-w-2xl">{intro}</p>}
      {
        dated && (
          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted">
            <div class="flex gap-2">
              <dt class="font-semibold text-ink">Effective date:</dt>
              <dd>{site.legal.effective}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-semibold text-ink">Last updated:</dt>
              <dd>{site.legal.updated}</dd>
            </div>
          </dl>
        )
      }
    </div>
  </div>
  <div class="container-site grid grid-cols-1 gap-10 py-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:py-16">
    {
      toc.length > 0 ? (
        <aside class="no-print lg:sticky lg:top-24 lg:self-start">
          <nav aria-label="On this page" class="rounded-xl border border-line p-5">
            <p class="text-sm font-semibold">On this page</p>
            <ol class="mt-3 space-y-2 text-[0.92rem]">
              {toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} class="text-muted no-underline hover:text-accent">
                    {t.label}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      ) : (
        <div class="hidden lg:block" />
      )
    }
    <article class="prose-legal">
      <slot />
    </article>
  </div>
</Base>

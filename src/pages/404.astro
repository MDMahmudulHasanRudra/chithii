---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for does not exist.">
  <section class="section bg-white">
    <div class="container-site max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-semibold">This page does not exist</h1>
      <p class="lead mt-4">It may have moved. Try one of these instead.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/features" class="btn btn-secondary">Features</a>
        <a href="/contact" class="btn btn-secondary">Contact</a>
      </div>
    </div>
  </section>
</Base>

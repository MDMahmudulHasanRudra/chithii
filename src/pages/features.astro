---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { featureGroups, reports, totalFeatures, totalReports } from '../data/features';
---

<Base
  title="Features"
  description={`Everything Chithii does: an omnichannel inbox, AI replies from your knowledge, routing and SLAs, ${totalReports} support reports, commerce and payments, Social Studio and an open API. ${totalFeatures}+ capabilities, all available today.`}
>
  <section class="border-b border-line bg-mist">
    <div class="container-site py-14 sm:py-20">
      <p class="eyebrow">Features</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold sm:text-5xl">Everything Chithii does, in plain words.</h1>
      <p class="lead mt-5 max-w-2xl">
        {totalFeatures}+ capabilities across seven areas, all live in the app today. Turn on the modules you need for each project and leave the
        rest off. Switching a module off never deletes its data.
      </p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-ok/30 bg-ok-soft px-3.5 py-1.5 text-sm font-semibold text-ok-ink">
        <span class="size-2 rounded-full bg-ok"></span> Every feature on this page is available now
      </p>
    </div>
  </section>

  <nav aria-label="Feature areas" class="no-print sticky top-[4.5rem] z-30 border-b border-line bg-white/95 backdrop-blur">
    <ul class="container-site flex gap-1 overflow-x-auto py-2 text-sm whitespace-nowrap [scrollbar-width:none]">
      {
        featureGroups.map((g) => (
          <li>
            <a href={`#${g.id}`} class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 font-medium text-muted no-underline hover:bg-mist hover:text-ink">
              <Icon name={g.icon} size={16} />
              {g.eyebrow}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    featureGroups.map((g, gi) => (
      <section id={g.id} class:list={['section scroll-mt-32', gi % 2 === 1 ? 'bg-mist' : 'bg-white']}>
        <div class="container-site">
          <div class="grid gap-6 lg:grid-cols-[1fr_1.3fr] lg:items-end">
            <div>
              <p class="eyebrow flex items-center gap-2">
                <Icon name={g.icon} size={16} />
                {g.eyebrow}
              </p>
              <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{g.title}</h2>
            </div>
            <p class="lead">{g.intro}</p>
          </div>

          <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.features.map((f) => (
              <li class="card flex flex-col p-6">
                <div class="flex items-start justify-between gap-3">
                  <span class="flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent-ink">
                    <Icon name={f.icon} />
                  </span>
                  <span class="rounded-full bg-ok-soft px-2.5 py-1 text-xs font-semibold text-ok-ink">
                    {f.status === 'beta' ? 'Beta' : 'Available'}
                  </span>
                </div>
                <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{f.body}</p>
                {f.points && (
                  <ul class="mt-4 space-y-1.5 border-t border-line pt-4 text-[0.92rem]">
                    {f.points.map((p) => (
                      <li class="flex gap-2">
                        <Icon name="tick" size={16} class="mt-0.5 shrink-0 text-accent" />
                        {p}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>

          {g.id === 'reports' && (
            <div class="card mt-8 p-6 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-xl font-semibold">The full report catalogue</h3>
                <p class="text-sm text-muted">Any date range · export to CSV or Excel · Dhaka time</p>
              </div>
              <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
                {reports.map((r) => (
                  <div>
                    <p class="text-sm font-semibold text-accent-ink">{r.category}</p>
                    <ul class="mt-2 space-y-1.5 text-[0.95rem]">
                      {r.items.map((i) => (
                        <li class="flex gap-2">
                          <Icon name="chart" size={16} class="mt-0.5 shrink-0 text-subtle" />
                          {i}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-line bg-white py-10">
    <div class="container-site flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-muted">
      <span class="font-semibold text-ink">Status labels</span>
      <span class="inline-flex items-center gap-2"><span class="rounded-full bg-ok-soft px-2.5 py-1 text-xs font-semibold text-ok-ink">Available</span> You can use it now.</span>
      <span class="inline-flex items-center gap-2"><span class="rounded-full bg-ok-soft px-2.5 py-1 text-xs font-semibold text-ok-ink">Beta</span> Usable, still being refined.</span>
      <span class="ml-auto flex gap-4">
        <a href="/integrations">All integrations</a>
        <a href="/contact">Ask about a feature</a>
      </span>
    </div>
  </section>

  <CTA />
</Base>

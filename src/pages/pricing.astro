---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../config/site';
import {
  addons,
  comparison,
  isFree,
  money,
  perMonthYearly,
  plans,
  pricingFaqs,
  trialDays,
  yearlyDiscount,
  custom,
  rates,
  valueComparison,
  type Currency,
} from '../data/pricing';

const firstPaid = plans.find((p) => p.price && !isFree(p))!;
const mail = (subject: string) => `mailto:${site.email.contact}?subject=${encodeURIComponent(subject)}`;
const seatsOf = (label: string) => Number.parseInt(label, 10) || 1;

// The billing and currency switches are radio buttons and CSS (:has), because the site's CSP allows no
// inline script. Inputs, in this order, are direct children of the .group/p wrapper: #bm #by, #cb #cu.
// Taka monthly is the default and the fallback for a browser without :has.
const show = {
  'bdt-monthly': 'block group-has-[#by:checked]/p:hidden group-has-[#cu:checked]/p:hidden',
  'bdt-yearly': 'hidden group-has-[#by:checked~#cb:checked]/p:block',
  'usd-monthly': 'hidden group-has-[#bm:checked~#cu:checked]/p:block',
  'usd-yearly': 'hidden group-has-[#by:checked~#cu:checked]/p:block',
} as const;
// Inline variants of the same rules, for prices inside a sentence or a table header.
const showInline = {
  bdt: 'inline group-has-[#cu:checked]/p:hidden',
  usd: 'hidden group-has-[#cu:checked]/p:inline',
} as const;
const views: { key: keyof typeof show; c: Currency; yearly: boolean }[] = [
  { key: 'bdt-monthly', c: 'bdt', yearly: false },
  { key: 'bdt-yearly', c: 'bdt', yearly: true },
  { key: 'usd-monthly', c: 'usd', yearly: false },
  { key: 'usd-yearly', c: 'usd', yearly: true },
];

const seg = 'cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors hover:text-ink';
// Written out in full so Tailwind can see every class (it does not read classes built from a template).
const on = {
  bm: 'group-has-[#bm:checked]/p:bg-white group-has-[#bm:checked]/p:text-ink group-has-[#bm:checked]/p:shadow-[var(--shadow-card)] group-has-[#bm:focus-visible]/p:outline-2 group-has-[#bm:focus-visible]/p:outline-accent',
  by: 'group-has-[#by:checked]/p:bg-white group-has-[#by:checked]/p:text-ink group-has-[#by:checked]/p:shadow-[var(--shadow-card)] group-has-[#by:focus-visible]/p:outline-2 group-has-[#by:focus-visible]/p:outline-accent',
  cb: 'group-has-[#cb:checked]/p:bg-white group-has-[#cb:checked]/p:text-ink group-has-[#cb:checked]/p:shadow-[var(--shadow-card)] group-has-[#cb:focus-visible]/p:outline-2 group-has-[#cb:focus-visible]/p:outline-accent',
  cu: 'group-has-[#cu:checked]/p:bg-white group-has-[#cu:checked]/p:text-ink group-has-[#cu:checked]/p:shadow-[var(--shadow-card)] group-has-[#cu:focus-visible]/p:outline-2 group-has-[#cu:focus-visible]/p:outline-accent',
} as const;

// What the Custom card's script needs to suggest a cheaper standard plan: each plan's price, seats
// and projects. Passed as a data attribute (the CSP allows no inline script).
const planFacts = JSON.stringify(
  plans
    .filter((p) => p.price)
    .map((p) => ({
      id: p.id,
      name: p.name,
      seats: Number.parseInt(p.limits.seats, 10) || 1,
      projects: Number.parseInt(p.limits.projects, 10) || 1,
      bdt: { monthly: p.price!.bdt.monthly, yearly: p.price!.bdt.yearly, seat: p.price!.bdt.extraSeat },
      usd: { monthly: p.price!.usd.monthly, yearly: p.price!.usd.yearly, seat: p.price!.usd.extraSeat },
    })),
);


// Categories shown open before "Full comparison"; the rest start folded.
const openGroups = 3;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Base
  title="Pricing"
  description={`Chithii is free for one person, and paid plans start at ${money('bdt', firstPaid.price!.bdt.monthly)} (${money('usd', firstPaid.price!.usd.monthly)}) a month: every channel in one inbox, unlimited AI replies from your own knowledge, SLAs, reports and commerce. ${trialDays}-day free trial.`}
  jsonLd={[faqSchema]}
>
  <div class="group/p">
    <input type="radio" name="billing" id="bm" class="sr-only" checked />
    <input type="radio" name="billing" id="by" class="sr-only" />
    <input type="radio" name="currency" id="cb" class="sr-only" checked />
    <input type="radio" name="currency" id="cu" class="sr-only" />

    <!-- Plans -->
    <section class="relative overflow-hidden bg-mist">
      <div class="pointer-events-none absolute -top-48 left-1/2 size-[46rem] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative container-site pt-14 pb-16 sm:pt-20 sm:pb-20 2xl:max-w-[98rem]">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Pricing</p>
          <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Choose the right plan for your team</h1>
          <p class="lead mt-4">Every plan includes AI that answers from your own knowledge, with unlimited AI replies and no charge per reply.</p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <div role="group" aria-label="Billing period" class="inline-flex rounded-full border border-line bg-sunken p-1">
              <label for="bm" class={`${seg} ${on.bm}`}>Pay monthly</label>
              <label for="by" class={`${seg} ${on.by}`}>
                Pay yearly <span class="ml-1 rounded-full bg-ok-soft px-2 py-0.5 text-xs font-semibold text-ok-ink">Save {yearlyDiscount}</span>
              </label>
            </div>
            <div role="group" aria-label="Currency" class="inline-flex rounded-full border border-line bg-sunken p-1">
              <label for="cb" class={`${seg} ${on.cb}`}>৳ Taka</label>
              <label for="cu" class={`${seg} ${on.cu}`}>$ US dollar</label>
            </div>
          </div>
        </div>

        <ul class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4 2xl:grid-cols-5 2xl:items-start">
          {
            plans.map((plan) => {
              const free = isFree(plan);
              const included = seatsOf(plan.limits.seats);
              const includedProjects = seatsOf(plan.limits.projects);
              const canAddSeats = !free && plan.price !== null && plan.price.usd.extraSeat !== null;
              return (
                <li
                  data-plan={plan.id}
                  class:list={[
                    'relative flex flex-col rounded-2xl border bg-white p-6',
                    plan.popular ? 'border-accent shadow-[var(--shadow-float)] ring-1 ring-accent' : 'border-line shadow-[var(--shadow-card)]',
                  ]}
                >
                  {plan.popular && (
                    <span class="bg-brand-gradient absolute -top-3 right-6 rounded-full px-3 py-1 text-xs font-semibold text-white">Most popular</span>
                  )}
                  <h2 class="text-xl font-semibold">{plan.name}</h2>
                  <p class="mt-2 min-h-[3rem] text-[0.95rem] leading-relaxed text-muted">{plan.tagline}</p>

                  <div class="mt-5 min-h-[4.25rem]">
                    {free ? (
                      <div>
                        <p class="flex items-baseline gap-1.5">
                          <span class={`${showInline.bdt} text-4xl font-semibold tracking-tight`}>{money('bdt', 0)}</span>
                          <span class={`${showInline.usd} text-4xl font-semibold tracking-tight`}>{money('usd', 0)}</span>
                          <span class="text-sm text-muted">/ month</span>
                        </p>
                        <p class="mt-1.5 text-sm text-muted">Free, with no time limit</p>
                      </div>
                    ) : (
                      views.map((v) => {
                        const p = plan.price![v.c];
                        const seat = p.extraSeat ?? 0;
                        const base = v.yearly ? perMonthYearly(p) : p.monthly;
                        return (
                          <div class={show[v.key]}>
                            <p class="flex items-baseline gap-1.5">
                              <span class="text-4xl font-semibold tracking-tight" data-amount data-c={v.c} data-base={base} data-seat={seat} data-project={rates.extraProject[v.c]}>
                                {money(v.c, base)}
                              </span>
                              <span class="text-sm text-muted">/ month</span>
                            </p>
                            <p class="mt-1.5 text-sm text-muted">
                              {v.yearly ? (
                                <>
                                  <span data-amount data-c={v.c} data-base={p.yearly} data-seat={seat * 12} data-project={rates.extraProject[v.c] * 12}>
                                    {money(v.c, p.yearly)}
                                  </span>{' '}
                                  billed yearly
                                </>
                              ) : (
                                'Billed monthly'
                              )}
                            </p>
                          </div>
                        );
                      })
                    )}
                  </div>

                  {canAddSeats ? (
                    <div class="mt-5 space-y-2">
                      {[
                        { key: 'seats', label: 'Seats', start: included },
                        { key: 'projects', label: 'Projects', start: includedProjects },
                      ].map((c) => (
                        <div class="flex items-center justify-between rounded-lg border border-line bg-mist px-3 py-2" data-counter={c.key} data-included={c.start}>
                          <span class="text-sm font-medium">{c.label}</span>
                          <span class="flex items-center gap-1">
                            <button type="button" data-step="-1" class="hidden size-8 items-center justify-center rounded-md border border-line bg-white text-lg leading-none font-semibold text-ink hover:border-tide disabled:opacity-40 [.js_&]:flex" aria-label={`Fewer ${c.label.toLowerCase()} on ${plan.name}`}>−</button>
                            <output class="min-w-8 text-center text-sm font-semibold" aria-live="polite">{c.start}</output>
                            <button type="button" data-step="1" class="hidden size-8 items-center justify-center rounded-md border border-line bg-white text-lg leading-none font-semibold text-ink hover:border-tide [.js_&]:flex" aria-label={`More ${c.label.toLowerCase()} on ${plan.name}`}>+</button>
                          </span>
                        </div>
                      ))}
                      <p class="text-xs text-muted">
                        {included} seats and {includedProjects} {includedProjects === 1 ? 'project' : 'projects'} included. Extra seat{' '}
                        <span class={showInline.bdt}>{money('bdt', rates.extraSeat.bdt)}</span><span class={showInline.usd}>{money('usd', rates.extraSeat.usd)}</span>, extra project{' '}
                        <span class={showInline.bdt}>{money('bdt', rates.extraProject.bdt)}</span><span class={showInline.usd}>{money('usd', rates.extraProject.usd)}</span> a month.
                      </p>
                    </div>
                  ) : (
                    <div class="mt-5 flex items-center justify-between rounded-lg border border-line bg-mist px-3 py-2">
                      <span class="text-sm font-medium">Seats</span>
                      <span class="min-w-8 py-1.5 text-center text-sm font-semibold">{included}</span>
                    </div>
                  )}

                  <a href={mail(plan.cta.subject)} class:list={['btn mt-4 w-full', plan.popular ? 'btn-primary' : free ? 'btn-secondary' : 'btn-primary']}>
                    {plan.cta.label}
                  </a>

                  <p class="mt-6 text-sm font-semibold text-ink">{plan.includesFrom ? `Everything in ${plan.includesFrom}, plus` : 'Key features'}</p>
                  <ul class="mt-3 space-y-2.5 text-[0.95rem] leading-snug">
                    {[plan.limits.seats, plan.limits.projects, plan.limits.whatsapp, plan.limits.storage, ...plan.highlights].map((h, i) => (
                      <li class="flex gap-2.5">
                        <Icon name="tick" size={18} class="mt-0.5 shrink-0 text-ok" />
                        <span class:list={['text-ink', i < 4 && 'font-medium']}>{h}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
          <!-- Custom: build a plan option by option. Totals are worked out by /js/pricing-custom.js. -->
          <li
            id="custom"
            data-custom
            data-base-bdt={custom.base.bdt}
            data-base-usd={custom.base.usd}
            data-seat-bdt={custom.extraSeat.bdt}
            data-seat-usd={custom.extraSeat.usd}
            data-project-bdt={custom.extraProject.bdt}
            data-project-usd={custom.extraProject.usd}
            data-included-seats={custom.seats}
            data-plans={planFacts}
            data-mail={site.email.contact}
            data-discount="0.15"
            class="relative flex flex-col rounded-2xl border border-dashed border-accent-line bg-white p-6 shadow-[var(--shadow-card)] md:col-span-2 xl:col-span-4 2xl:col-span-1"
          >
            <span class="bg-brand-gradient absolute -top-3 right-6 rounded-full px-3 py-1 text-xs font-semibold text-white">Build your own</span>
            <div class="xl:grid xl:grid-cols-[17rem_1fr] xl:gap-8 2xl:block">
              <div>
                <h2 class="text-xl font-semibold">Custom</h2>
                <p class="mt-2 min-h-[3rem] text-[0.95rem] leading-relaxed text-muted">Tick only the channels and features you need, and see your price.</p>

                <div class="mt-5 min-h-[4.25rem]">
                  {
                    views.map((v) => (
                      <div class={show[v.key]}>
                        <p class="flex items-baseline gap-1.5">
                          <span class="text-4xl font-semibold tracking-tight" data-custom-amount={v.key}>
                            {money(v.c, v.yearly ? custom.base[v.c] * (1 - 0.15) : custom.base[v.c])}
                          </span>
                          <span class="text-sm text-muted">/ month</span>
                        </p>
                        <p class="mt-1.5 text-sm text-muted">
                          {v.yearly ? (
                            <>
                              <span data-custom-yearly={v.key}>{money(v.c, custom.base[v.c] * 12 * (1 - 0.15))}</span> billed yearly
                            </>
                          ) : (
                            'Billed monthly'
                          )}
                        </p>
                      </div>
                    ))
                  }
                </div>

                <div class="mt-5 space-y-2">
                  {
                    [
                      { key: 'seats', label: 'Seats', start: custom.seats },
                      { key: 'projects', label: 'Projects', start: 1 },
                    ].map((c) => (
                      <div class="flex items-center justify-between rounded-lg border border-line bg-mist px-3 py-2" data-custom-count={c.key} data-min={c.start}>
                        <span class="text-sm font-medium">{c.label}</span>
                        <span class="flex items-center gap-1">
                          <button type="button" data-step="-1" disabled class="hidden size-8 items-center justify-center rounded-md border border-line bg-white text-lg leading-none font-semibold text-ink hover:border-tide disabled:opacity-40 [.js_&]:flex" aria-label={`Fewer ${c.label.toLowerCase()} on Custom`}>−</button>
                          <output class="min-w-8 text-center text-sm font-semibold" aria-live="polite">{c.start}</output>
                          <button type="button" data-step="1" class="hidden size-8 items-center justify-center rounded-md border border-line bg-white text-lg leading-none font-semibold text-ink hover:border-tide [.js_&]:flex" aria-label={`More ${c.label.toLowerCase()} on Custom`}>+</button>
                        </span>
                      </div>
                    ))
                  }
                  <p class="text-xs text-muted">
                    {custom.seats} seats included. Extra seat <span class={showInline.bdt}>{money('bdt', custom.extraSeat.bdt)}</span><span class={showInline.usd}>{money('usd', custom.extraSeat.usd)}</span>,
                    extra project <span class={showInline.bdt}>{money('bdt', custom.extraProject.bdt)}</span><span class={showInline.usd}>{money('usd', custom.extraProject.usd)}</span> a month.
                  </p>
                </div>

                <p data-custom-hint class="mt-4 hidden rounded-lg border border-ok/30 bg-ok-soft px-3 py-2 text-sm text-ok-ink" aria-live="polite"></p>

                <a href={mail('Chithii Custom plan')} data-custom-cta class="btn btn-primary mt-4 w-full">Get this plan</a>

                <p class="mt-6 text-sm font-semibold text-ink">Always included</p>
                <ul class="mt-3 space-y-2 text-[0.95rem] leading-snug">
                  {
                    custom.includes.map((h) => (
                      <li class="flex gap-2.5">
                        <Icon name="tick" size={18} class="mt-0.5 shrink-0 text-ok" />
                        <span>{h}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="mt-6 gap-x-4 sm:columns-2 xl:mt-0 xl:columns-3 2xl:mt-6 2xl:columns-1">
                {
                  custom.groups.map((g, gi) => (
                    <details class="group/o mb-2 break-inside-avoid rounded-lg border border-line" open={gi === 0}>
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2.5 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
                        <span>
                          {g.title} <span class="font-normal text-muted">({g.options.length})</span>
                        </span>
                        <svg width="14" height="14" viewBox="0 0 16 16" class="shrink-0 text-muted transition-transform group-open/o:rotate-180" aria-hidden="true">
                          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <fieldset class="px-1.5 pb-2">
                      <legend class="sr-only">{g.title}</legend>
                      <ul class="space-y-1.5">
                        {g.options.map((o) => (
                          <li>
                            <label class="flex cursor-pointer items-start gap-2.5 rounded-md px-1.5 py-1 text-[0.92rem] leading-snug hover:bg-mist has-[:checked]:bg-accent-soft">
                              <input
                                type="checkbox"
                                name={o.id}
                                data-opt
                                data-label={o.label}
                                data-bdt={o.price.bdt}
                                data-usd={o.price.usd}
                                data-per-seat={o.perSeat ? '1' : '0'}
                                data-in={o.in.join(' ')}
                                class="mt-0.5 size-4 shrink-0 accent-[var(--color-accent)]"
                              />
                              <span class="min-w-0 flex-1">{o.label}</span>
                              <span class="shrink-0 text-xs font-semibold whitespace-nowrap text-muted">
                                +<span class={showInline.bdt}>{money('bdt', o.price.bdt)}</span><span class={showInline.usd}>{money('usd', o.price.usd)}</span>
                                {o.perSeat && '/seat'}
                              </span>
                            </label>
                          </li>
                        ))}
                      </ul>
                      </fieldset>
                    </details>
                  ))
                }
              </div>
            </div>
          </li>
        </ul>

        <p class="mt-8 text-center text-sm text-muted">
          On every paid plan: extra seat <span class={showInline.bdt}>{money('bdt', rates.extraSeat.bdt)}</span><span class={showInline.usd}>{money('usd', rates.extraSeat.usd)}</span>,
          extra project <span class={showInline.bdt}>{money('bdt', rates.extraProject.bdt)}</span><span class={showInline.usd}>{money('usd', rates.extraProject.usd)}</span>,
          extra 5 GB storage <span class={showInline.bdt}>{money('bdt', rates.extraStorage.bdt)}</span><span class={showInline.usd}>{money('usd', rates.extraStorage.usd)}</span> a month.
          <a href="#compare" class="ml-1 font-semibold">See all features</a>
        </p>
      </div>
    </section>

    <!-- Value: what a 5-person team pays -->
    <section class="bg-white pt-16 sm:pt-20" aria-labelledby="value">
      <div class="container-site">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Compare before you choose</p>
          <h2 id="value" class="mt-3 text-3xl font-semibold sm:text-4xl">What a 5-person team pays each month</h2>
          <p class="lead mt-4">
            For WhatsApp, Facebook, Instagram and AI replies. Most tools charge per agent and again for AI; a Chithii plan already includes the
            seats, every channel and unlimited AI replies.
          </p>
        </div>
        <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-line">
          <table class="w-full border-collapse text-left text-[0.95rem]">
            <caption class="sr-only">Monthly price for a 5-person team</caption>
            <thead class="bg-mist">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold">Product</th>
                <th scope="col" class="px-4 py-3 text-right font-semibold">Per month</th>
                <th scope="col" class="hidden px-4 py-3 font-semibold sm:table-cell">What that includes</th>
              </tr>
            </thead>
            <tbody>
              {
                valueComparison.rows.map((row) => (
                  <tr class:list={['border-t border-line', row.ours && 'bg-accent-soft']}>
                    <th scope="row" class:list={['px-4 py-3 align-top', row.ours ? 'font-semibold text-accent-ink' : 'font-medium text-ink']}>
                      {row.name}
                      <span class="mt-1 block text-xs font-normal text-muted sm:hidden">{row.note}</span>
                    </th>
                    <td class:list={['px-4 py-3 text-right align-top whitespace-nowrap', row.ours ? 'text-lg font-semibold text-accent-ink' : 'text-ink']}>
                      <span class={showInline.bdt}>{money('bdt', row.bdt ?? row.usd * valueComparison.rate)}</span>
                      <span class={showInline.usd}>{money('usd', row.usd)}</span>
                    </td>
                    <td class="hidden px-4 py-3 align-top text-sm text-muted sm:table-cell">{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mx-auto mt-4 max-w-4xl text-center text-xs leading-relaxed text-muted">
          Other products: their published monthly prices on {valueComparison.checked} (Tidio billed yearly), converted at ৳{valueComparison.rate} per
          US dollar, for the plan that covers these channels and AI. Prices change; check each vendor’s own pricing page. With Chithii you pay your
          own AI provider for AI usage. Product names are trademarks of their owners.
        </p>
      </div>
    </section>

    <!-- Larger setup -->
    <section class="bg-white pt-16 sm:pt-20">
      <div class="container-site">
        <div class="mx-auto max-w-4xl rounded-2xl border border-line bg-mist px-6 py-10 text-center sm:px-12">
          <h2 class="text-2xl font-semibold sm:text-3xl">Need a larger or custom setup?</h2>
          <p class="lead mx-auto mt-3 max-w-2xl">
            For more than 15 seats, many brands or clients, custom integrations or help moving from your current tool, book a call. We will
            suggest the setup that fits your business, confirmed in writing.
          </p>
          <a href={mail('Chithii: larger or custom setup')} class="btn btn-primary mt-6">Book a demo</a>
        </div>
      </div>
    </section>

    <!-- Add-ons -->
    <section class="section bg-white" aria-labelledby="addons">
      <div class="container-site">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="addons" class="text-3xl font-semibold sm:text-4xl">Add only what your business needs</h2>
          <p class="lead mt-4">
            Grow any paid plan with more seats, projects or storage, or switch on a module from a higher plan. Add-ons are billed with your
            plan.
          </p>
        </div>
        <ul class="mt-12 grid gap-4 md:grid-cols-2">
          {
            addons.map((a) => (
              <li class="card flex gap-4 p-5">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent-ink">
                  <Icon name={a.icon} size={20} />
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h3 class="font-semibold">{a.name}</h3>
                    <p class="text-sm whitespace-nowrap text-muted">
                      {a.price ? (
                        <>
                          {a.note && <span>{a.note} </span>}
                          <span class={`${showInline.bdt} text-base font-semibold text-ink`}>{money('bdt', a.price.bdt)}</span>
                          <span class={`${showInline.usd} text-base font-semibold text-ink`}>{money('usd', a.price.usd)}</span> {a.per}
                        </>
                      ) : (
                        <span class="font-semibold text-accent-ink">{a.note}</span>
                      )}
                    </p>
                  </div>
                  <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted">{a.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Comparison -->
    <section class="section border-t border-line bg-mist" aria-labelledby="compare">
      <div class="container-site">
        <h2 id="compare" class="scroll-mt-24 text-center text-3xl font-semibold sm:text-4xl">Explore the best plan for your business</h2>
        <p class="lead mx-auto mt-4 max-w-2xl text-center">Every feature listed is live in the app today. <a href="/features">See what each one does</a>.</p>

        <!-- relative: the sr-only captions and headers inside are absolutely positioned and must not escape the scroll box. -->
        <div class="relative mt-10 overflow-x-auto lg:overflow-visible">
          <div class="min-w-[46rem]">
            <!-- Plan names stay in view while the table scrolls (wide screens). -->
            <div class="z-20 grid grid-cols-[2fr_repeat(4,1fr)] rounded-t-2xl border border-line bg-white lg:sticky lg:top-[4.5rem]">
              <p class="px-4 py-4 text-sm font-semibold text-muted">Features</p>
              {
                plans.map((p) => (
                  <div class:list={['px-3 py-4 text-center', p.popular && 'bg-accent-soft']}>
                    <p class:list={['font-semibold', p.popular && 'text-accent-ink']}>{p.name}</p>
                    <p class="mt-0.5 text-xs text-muted">
                      {isFree(p) ? (
                        'Free'
                      ) : (
                        <>
                          from <span class={showInline.bdt}>{money('bdt', p.price!.bdt.monthly)}</span>
                          <span class={showInline.usd}>{money('usd', p.price!.usd.monthly)}</span>/mo
                        </>
                      )}
                    </p>
                  </div>
                ))
              }
            </div>

            <div class="rounded-b-2xl border-x border-b border-line bg-white">
              {
                comparison.map((group, gi) => (
                  <details class="group/d border-t border-line first:border-t-0" open={gi < openGroups}>
                    <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-4 font-semibold [&::-webkit-details-marker]:hidden">
                      {group.title}
                      <span class="text-muted transition-transform group-open/d:rotate-180" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </span>
                    </summary>
                    <table class="w-full table-fixed border-collapse text-left text-[0.95rem]">
                      <caption class="sr-only">{group.title}</caption>
                      <colgroup>
                        <col class="w-[40%]" />
                        <col class="w-[15%]" />
                        <col class="w-[15%]" />
                        <col class="w-[15%]" />
                        <col class="w-[15%]" />
                      </colgroup>
                      <thead class="sr-only">
                        <tr>
                          <th scope="col">Feature</th>
                          {plans.map((p) => (
                            <th scope="col">{p.name}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {group.rows.map((row) => (
                          <tr class="border-t border-line">
                            <th scope="row" class="px-4 py-3 font-normal text-ink">{row.label}</th>
                            {row.cells.map((cell, i) => (
                              <td class:list={['px-3 py-3 text-center', plans[i].popular && 'bg-accent-soft/40']}>
                                {cell === true ? (
                                  <span class="inline-flex size-6 items-center justify-center rounded-full bg-ok text-white">
                                    <Icon name="tick" size={14} />
                                    <span class="sr-only">Included</span>
                                  </span>
                                ) : cell === false ? (
                                  <span class="text-subtle">
                                    <span aria-hidden="true">--</span>
                                    <span class="sr-only">Not included</span>
                                  </span>
                                ) : cell === 'Add-on' ? (
                                  <span class="rounded-full border border-marigold-line bg-marigold-soft px-2 py-0.5 text-xs font-semibold text-marigold-ink">Add-on</span>
                                ) : (
                                  <span class="text-sm font-medium text-ink">{cell}</span>
                                )}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </details>
                ))
              }
            </div>
          </div>
        </div>
        <p class="mt-4 text-center text-sm text-muted">Open any category to see every feature in it.</p>
      </div>
    </section>
  </div>

  <!-- FAQ -->
  <section class="section bg-white" aria-labelledby="pricing-faq">
    <div class="container-site max-w-4xl">
      <h2 id="pricing-faq" class="text-center text-3xl font-semibold sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-10"><FAQ items={pricingFaqs} /></div>
      <p class="mt-8 text-center text-muted">
        Something not covered? Email <a href={`mailto:${site.email.contact}`}>{site.email.contact}</a> and we will answer, in writing, before you pay.
      </p>
    </div>
  </section>

  <script is:inline src="/js/pricing-seats.js" defer></script>
  <script is:inline src="/js/pricing-custom.js" defer></script>
</Base>

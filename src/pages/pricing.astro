---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { site } from '../config/site';
import { comparison, money, perMonthYearly, plans, pricingFaqs, trialDays, type Currency } from '../data/pricing';

const mail = (subject: string) => `mailto:${site.email.contact}?subject=${encodeURIComponent(subject)}`;

// The switches are plain radio buttons and CSS (:has), because the site's CSP allows no inline script.
// Inputs, in this order, are direct children of the .group/p wrapper: #bm #by (billing), #cb #cu (currency).
// Taka monthly is the default and the fallback for a browser without :has.
const show = {
  'bdt-monthly': 'block group-has-[#by:checked]/p:hidden group-has-[#cu:checked]/p:hidden',
  'bdt-yearly': 'hidden group-has-[#by:checked~#cb:checked]/p:block',
  'usd-monthly': 'hidden group-has-[#bm:checked~#cu:checked]/p:block',
  'usd-yearly': 'hidden group-has-[#by:checked~#cu:checked]/p:block',
} as const;
const views: { key: keyof typeof show; c: Currency; yearly: boolean }[] = [
  { key: 'bdt-monthly', c: 'bdt', yearly: false },
  { key: 'bdt-yearly', c: 'bdt', yearly: true },
  { key: 'usd-monthly', c: 'usd', yearly: false },
  { key: 'usd-yearly', c: 'usd', yearly: true },
];

const seg = 'cursor-pointer rounded-md px-3.5 py-2 text-sm font-semibold text-muted transition-colors hover:text-ink';
// Written out in full so Tailwind can see every class (it does not read classes built from a template).
const onClass = {
  bm: 'group-has-[#bm:checked]/p:bg-white group-has-[#bm:checked]/p:text-ink group-has-[#bm:checked]/p:shadow-[var(--shadow-card)] group-has-[#bm:focus-visible]/p:outline-2 group-has-[#bm:focus-visible]/p:outline-accent',
  by: 'group-has-[#by:checked]/p:bg-white group-has-[#by:checked]/p:text-ink group-has-[#by:checked]/p:shadow-[var(--shadow-card)] group-has-[#by:focus-visible]/p:outline-2 group-has-[#by:focus-visible]/p:outline-accent',
  cb: 'group-has-[#cb:checked]/p:bg-white group-has-[#cb:checked]/p:text-ink group-has-[#cb:checked]/p:shadow-[var(--shadow-card)] group-has-[#cb:focus-visible]/p:outline-2 group-has-[#cb:focus-visible]/p:outline-accent',
  cu: 'group-has-[#cu:checked]/p:bg-white group-has-[#cu:checked]/p:text-ink group-has-[#cu:checked]/p:shadow-[var(--shadow-card)] group-has-[#cu:focus-visible]/p:outline-2 group-has-[#cu:focus-visible]/p:outline-accent',
} as const;
const on = (id: keyof typeof onClass) => onClass[id];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Base
  title="Pricing"
  description={`Chithii plans from ${money('bdt', plans[0].price!.bdt.monthly)} (${money('usd', plans[0].price!.usd.monthly)}) a month: every channel in one inbox, AI from your own knowledge with no per-reply fee, SLAs, reports and commerce. ${trialDays}-day free trial.`}
  jsonLd={[faqSchema]}
>
  <div class="group/p">
    <input type="radio" name="billing" id="bm" class="sr-only" checked />
    <input type="radio" name="billing" id="by" class="sr-only" />
    <input type="radio" name="currency" id="cb" class="sr-only" checked />
    <input type="radio" name="currency" id="cu" class="sr-only" />

    <section class="border-b border-line bg-mist">
      <div class="container-site pt-14 pb-10 sm:pt-20">
        <p class="eyebrow">Pricing</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold sm:text-5xl">One price for the whole team. No charge per AI reply.</h1>
        <p class="lead mt-5 max-w-2xl">
          Every plan includes all five channels, unlimited conversations and AI that answers from your own knowledge. Pick the plan for the way your
          team works, and try it free for {trialDays} days.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <div role="group" aria-label="Billing period" class="inline-flex rounded-lg border border-line bg-sunken p-1">
            <label for="bm" class={`${seg} ${on('bm')}`}>Monthly</label>
            <label for="by" class={`${seg} ${on('by')}`}>
              Yearly <span class="ml-1 rounded-full bg-ok-soft px-2 py-0.5 text-xs font-semibold text-ok-ink">2 months free</span>
            </label>
          </div>
          <div role="group" aria-label="Currency" class="inline-flex rounded-lg border border-line bg-sunken p-1">
            <label for="cb" class={`${seg} ${on('cb')}`}>৳ Taka</label>
            <label for="cu" class={`${seg} ${on('cu')}`}>$ US dollar</label>
          </div>
        </div>
      </div>
    </section>

    <!-- Plans -->
    <section class="bg-mist pb-16 sm:pb-24">
      <div class="container-site">
        <ul class="grid gap-5 pt-10 md:grid-cols-2 xl:grid-cols-4">
          {
            plans.map((plan) => (
              <li
                class:list={[
                  'relative flex flex-col rounded-2xl border p-6',
                  plan.popular ? 'border-tide bg-tide-deep text-tide-text shadow-[var(--shadow-float)]' : 'border-line bg-white shadow-[var(--shadow-card)]',
                ]}
              >
                {plan.popular && (
                  <span class="absolute -top-3 left-6 rounded-full bg-marigold px-3 py-1 text-xs font-semibold text-white">Most popular</span>
                )}
                <h2 class:list={['text-xl font-semibold', plan.popular && 'text-white']}>{plan.name}</h2>
                <p class:list={['mt-2 min-h-[4.5rem] text-[0.95rem] leading-relaxed', plan.popular ? 'text-tide-muted' : 'text-muted']}>{plan.tagline}</p>

                <div class="mt-5 min-h-[5.5rem]">
                  {plan.price ? (
                    views.map((v) => {
                      const p = plan.price![v.c];
                      return (
                        <div class={show[v.key]}>
                          <p class="flex items-baseline gap-1.5">
                            <span class:list={['text-4xl font-semibold tracking-tight', plan.popular ? 'text-white' : 'text-ink']}>
                              {money(v.c, v.yearly ? perMonthYearly(p) : p.monthly)}
                            </span>
                            <span class:list={['text-sm', plan.popular ? 'text-tide-muted' : 'text-muted']}>/ month</span>
                          </p>
                          <p class:list={['mt-1.5 text-sm', plan.popular ? 'text-tide-muted' : 'text-muted']}>
                            {v.yearly ? `${money(v.c, p.yearly)} billed yearly` : 'Billed monthly'}
                            <br />
                            Extra seat {money(v.c, p.extraSeat)} / month
                          </p>
                        </div>
                      );
                    })
                  ) : (
                    <div>
                      <p class="text-4xl font-semibold tracking-tight text-ink">Custom</p>
                      <p class="mt-1.5 text-sm text-muted">
                        A price for your team size,
                        <br />
                        agreed in writing
                      </p>
                    </div>
                  )}
                </div>

                <a
                  href={mail(plan.cta.subject)}
                  class:list={['btn mt-6 w-full', plan.popular ? 'btn-light' : plan.price ? 'btn-primary' : 'btn-secondary']}
                >
                  {plan.cta.label}
                </a>

                <ul class:list={['mt-6 grid gap-1.5 border-y py-4 text-sm font-semibold', plan.popular ? 'border-tide-line text-white' : 'border-line text-ink']}>
                  <li class="flex items-center gap-2"><Icon name="users" size={16} class={plan.popular ? 'text-accent-bright' : 'text-accent'} />{plan.limits.seats}</li>
                  <li class="flex items-center gap-2"><Icon name="layers" size={16} class={plan.popular ? 'text-accent-bright' : 'text-accent'} />{plan.limits.projects}</li>
                  <li class="flex items-center gap-2"><Icon name="whatsapp" size={16} class={plan.popular ? 'text-accent-bright' : 'text-accent'} />{plan.limits.whatsapp}</li>
                </ul>

                {plan.includesFrom && (
                  <p class:list={['mt-4 text-sm font-semibold', plan.popular ? 'text-white' : 'text-ink']}>Everything in {plan.includesFrom}, plus:</p>
                )}
                <ul class="mt-3 space-y-2.5 text-[0.95rem] leading-snug">
                  {plan.highlights.map((h) => (
                    <li class="flex gap-2.5">
                      <Icon name="tick" size={18} class:list={['mt-0.5 shrink-0', plan.popular ? 'text-accent-bright' : 'text-ok']} />
                      <span class={plan.popular ? 'text-tide-text' : 'text-ink'}>{h}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted">
          <li class="flex items-center gap-1.5"><Icon name="tick" size={16} class="text-ok" />{trialDays}-day free trial on every plan</li>
          <li class="flex items-center gap-1.5"><Icon name="tick" size={16} class="text-ok" />Unlimited conversations and contacts</li>
          <li class="flex items-center gap-1.5"><Icon name="tick" size={16} class="text-ok" />No per-reply or per-resolution AI fee</li>
          <li class="flex items-center gap-1.5"><Icon name="tick" size={16} class="text-ok" />Pay by bKash, card or bank transfer</li>
        </ul>
      </div>
    </section>
  </div>

  <!-- Comparison -->
  <section class="section bg-white" aria-labelledby="compare">
    <div class="container-site">
      <h2 id="compare" class="text-3xl font-semibold sm:text-4xl">Compare plans</h2>
      <p class="lead mt-3 max-w-2xl">Every feature listed is live in the app today. <a href="/features">See what each one does</a>.</p>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-line">
        <table class="w-full min-w-[46rem] border-collapse text-left text-[0.95rem]">
          <thead>
            <tr class="bg-mist">
              <th scope="col" class="sticky left-0 z-10 w-[38%] bg-mist px-4 py-4 font-semibold"><span class="sr-only">Feature</span></th>
              {plans.map((p) => (
                <th scope="col" class:list={['px-4 py-4 text-center font-semibold', p.popular && 'text-accent-ink']}>{p.name}</th>
              ))}
            </tr>
          </thead>
          {
            comparison.map((group) => (
              <tbody>
                <tr>
                  <th scope="rowgroup" colspan="5" class="sticky left-0 border-t border-line bg-white px-4 pt-6 pb-2 text-xs font-semibold tracking-[0.08em] text-accent uppercase">
                    {group.title}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr class="border-t border-line">
                    <th scope="row" class="sticky left-0 z-10 bg-white px-4 py-3 font-normal text-ink">{row.label}</th>
                    {row.cells.map((cell, i) => (
                      <td class:list={['px-4 py-3 text-center', plans[i].popular && 'bg-accent-soft/50']}>
                        {cell === true ? (
                          <span class="inline-flex text-ok"><Icon name="tick" size={18} /><span class="sr-only">Included</span></span>
                        ) : cell === false ? (
                          <span class="text-subtle" aria-label="Not included">—</span>
                        ) : (
                          <span class="text-sm font-medium text-ink">{cell}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-mist" aria-labelledby="pricing-faq">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h2 id="pricing-faq" class="text-3xl font-semibold sm:text-4xl">Pricing questions</h2>
        <p class="lead mt-4">
          Something not covered? Email <a href={`mailto:${site.email.contact}`}>{site.email.contact}</a> and we will answer, in writing, before you pay.
        </p>
      </div>
      <FAQ items={pricingFaqs} />
    </div>
  </section>

  <CTA
    title="Try Chithii with your own conversations"
    body={`${trialDays} days free on any plan. Tell us your channels and team size, and we will set up a workspace for you.`}
  />
</Base>

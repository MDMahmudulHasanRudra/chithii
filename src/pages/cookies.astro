---
import Legal from '../layouts/Legal.astro';
import { site } from '../config/site';
const n = site.name;
const toc = [
  { id: 'website', label: 'This website' },
  { id: 'app', label: `The ${site.name} app` },
  { id: 'questions', label: 'Questions' },
];
---

<Legal
  title="Cookies"
  description={`${n}'s website uses Google Tag Manager to measure visits. This page explains the cookies that can involve, and lists the cookies used by the ${n} app.`}
  intro={`The website at ${site.domain} uses Google Tag Manager to understand how the site is used. In the EU, the UK and Switzerland no analytics or advertising cookies are stored.`}
  toc={toc}
>
  <h2 id="website" class="!mt-0">This website ({site.domain})</h2>
  <ul>
    <li>
      <strong>Google Tag Manager</strong> (Google LLC) loads on every page. It runs the measurement tags we choose, such as Google Analytics,
      which can set cookies (for example <code>_ga</code> and <code>_ga_*</code>, kept for up to two years) to count visits and see which pages
      are used.
    </li>
    <li>
      For visitors in the European Economic Area, the United Kingdom and Switzerland, Google’s Consent Mode is set to deny analytics and
      advertising storage: no such cookies are stored, and Google receives only cookieless measurements.
    </li>
    <li>Our own pages set no cookies, and fonts and images are served from this site.</li>
    <li>
      You can block or delete these cookies in your browser settings, or install
      <a href="https://tools.google.com/dlpage/gaoptout">Google’s opt-out add-on</a>. Google explains its use of data at
      <a href="https://policies.google.com/technologies/partner-sites">policies.google.com</a>.
    </li>
  </ul>

  <h2 id="app">The {n} app</h2>
  <p>
    The app you sign in to, at <a href={site.appUrl}>app.{site.domain}</a>, is a separate service. The app uses only the cookies it needs to sign
    you in and keep you signed in: a session cookie, a security (CSRF) cookie and a cookie that remembers where to return after signing in. It
    uses no analytics or advertising cookies.
  </p>

  <h2 id="questions">Questions</h2>
  <p>Email <a href={`mailto:${site.email.privacy}`}>{site.email.privacy}</a>.</p>
</Legal>

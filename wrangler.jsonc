{
  // Cloudflare Workers with static assets. Cloudflare Workers Builds runs `npm run build` and `npx wrangler deploy`
  // on every push to main. public/_headers (security headers) and public/_redirects are honoured.
  // The name matches the Worker that Workers Builds deploys to ("chithi").
  "name": "chithi",
  "compatibility_date": "2026-11-01",
  // worker/index.js only redirects www.chithii.com to chithii.com; every other request is a static file.
  "main": "worker/index.js",
  // chithii.com and www.chithii.com are served through Worker ROUTES, not "custom domains": both hostnames
  // have their own DNS records, and Cloudflare refuses a custom domain on a hostname with DNS records
  // (error 100117). A failed custom-domain step also dropped the route, which took the site down with
  // Error 1000 (17 Nov 2026).
  "routes": [
    { "pattern": "chithii.com/*", "zone_name": "chithii.com" },
    { "pattern": "www.chithii.com/*", "zone_name": "chithii.com" }
  ],
  "workers_dev": true,
  // The admin portal saves src/data/pricing.json to this repository and branch. Secrets (set in the
  // Cloudflare dashboard, never in this file): ADMIN_PASSWORD and GITHUB_TOKEN.
  "vars": {
    "GITHUB_REPO": "MDMahmudulHasanRudra/chithii",
    "GITHUB_BRANCH": "main",
    "PRICING_PATH": "src/data/pricing.json"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker must see www requests before a static file answers them, or www would serve pages.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}

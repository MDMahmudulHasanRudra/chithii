{
  // Cloudflare Workers static assets. `npm run deploy` builds and uploads dist/.
  // public/_headers (security headers) and public/_redirects are honoured.
  "name": "chithii-site",
  "compatibility_date": "2026-11-01",
  // Attach the apex domain (the chithii.com zone is already on Cloudflare).
  // www.chithii.com is redirected to the apex with a Cloudflare Redirect Rule.
  "routes": [{ "pattern": "chithii.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
